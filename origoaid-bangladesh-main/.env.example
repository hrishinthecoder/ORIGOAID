# Optional: enables live AI features (description generator, OrigoBot chat).
# Without these, the app uses a deterministic local fallback so demos still work.
#
# WARNING: in production, NEVER ship the Anthropic API key to the browser.
# Proxy the calls through your own backend (e.g. /api/ai) and keep the key server-side.
#
# Sign up at https://console.anthropic.com to get an API key.
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
